# Copy to .env.development or .env.staging and replace placeholders only with
# identifiers belonging to isolated v2 resources.
V2_ENVIRONMENT=development
FIREBASE_PROJECT_ID=replace-with-development-project-id
FIREBASE_AUTH_DOMAIN=replace-with-development-auth-domain
APPS_SCRIPT_PROJECT_ID=replace-with-development-script-id
CALENDAR_ID=replace-with-test-calendar-id
DRIVE_FOLDER_ID=replace-with-test-drive-folder-id
SYNC_ENABLED=false
